{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matrakalaka/codex-project-bootstrap/playbooks/schema.v0.json",
  "title": "Versioned Engineering Playbook v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "fingerprint", "purpose", "applicability", "phases", "required_discovery", "required_artifacts", "required_verification", "allowed_capabilities", "human_gates", "stop_conditions", "failure_handling", "prohibited_shortcuts", "platform_requirements"],
  "properties": {
    "schema_version": {"const": "engineering_playbook.v0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "purpose": {"type": "string", "minLength": 1},
    "applicability": {"type": "object", "additionalProperties": false, "required": ["preconditions", "excluded_cases"], "properties": {"preconditions": {"type": "array", "items": {"type": "string"}}, "excluded_cases": {"type": "array", "items": {"type": "string"}}}},
    "phases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "objective", "required_artifacts", "required_verification"], "properties": {"id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}, "required_artifacts": {"type": "array", "items": {"type": "string"}}, "required_verification": {"type": "array", "items": {"type": "string"}}}}},
    "required_discovery": {"type": "array", "items": {"type": "string"}},
    "required_artifacts": {"type": "array", "items": {"type": "string"}},
    "required_verification": {"type": "array", "items": {"type": "string"}},
    "allowed_capabilities": {"type": "array", "items": {"type": "string"}},
    "human_gates": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_handling": {"type": "array", "items": {"type": "string"}},
    "prohibited_shortcuts": {"type": "array", "items": {"type": "string"}},
    "platform_requirements": {"type": "object", "additionalProperties": false, "required": ["common", "windows", "macos"], "properties": {"common": {"type": "array", "items": {"type": "string"}}, "windows": {"type": "array", "items": {"type": "string"}}, "macos": {"type": "array", "items": {"type": "string"}}}}
  }
}
