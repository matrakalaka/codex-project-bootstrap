# Inject these values from an approved secret manager; do not commit real values.
AGENTTERM_ENV=production
AGENTTERM_DATABASE_URL=postgresql://agentterm@127.0.0.1:5432/agentterm
AGENTTERM_SYNC_URL=https://sync.example.invalid
AGENTTERM_SYNC_TOKEN=<secret-manager-injected-bearer-token>
AGENTTERM_TRUST_REGISTRY=/etc/agentterm/trust-registry.json
AGENTTERM_BIND_HOST=127.0.0.1
AGENTTERM_BIND_PORT=8765
AGENTTERM_ENABLE_PRODUCTION_GIT=0
AGENTTERM_REQUIRE_KEYCHAIN=1
